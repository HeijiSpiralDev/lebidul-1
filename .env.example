# Copie ce fichier en `.env` à la racine du projet et adapte les valeurs.
# Le `.env` est chargé par python-dotenv au démarrage de Django.

# === Django ===
# En dev tu peux laisser la valeur par défaut. En prod, génère une vraie
# clé : `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=dev-secret-key-change-in-production
DJANGO_SETTINGS_MODULE=lebidul.settings.dev

# === Base de données (Postgres) ===
# Doivent correspondre à ton instance Postgres locale (ou aux valeurs du
# docker-compose.yml si tu utilises Docker).
DB_NAME=lebidul
DB_USER=lebidul
DB_PASSWORD=lebidul
DB_HOST=localhost
DB_PORT=5432

# === Cache (Redis) ===
REDIS_URL=redis://localhost:6379/0

# === Prod uniquement ===
# Liste séparée par des virgules. Inutile en dev.
# ALLOWED_HOSTS=lebidul.com,www.lebidul.com
